# ==============================================================================
# SECURE FILE STORAGE SYSTEM USING CRYPTOGRAPHY - CRYPTO6 MSD
# Database Layer Configuration Template (.env.example)
# ==============================================================================

# Environment Mode: development | test | production
NODE_ENV=development

# Database Name
DB_NAME=secure_file_storage

# Replica Set Name
MONGO_REPLICA_SET_NAME=rs0

# Admin Root Credentials (Used ONLY for Docker initialization & scripts/init-security.js)
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Admin Connection URI (Full administrative privilege - used for migration & user setup)
MONGODB_URI=

# Least-Privilege Application User Credentials
APP_DB_USER=
APP_DB_PASSWORD=

# Application Connection URI (Used by Express Backend and standard database services)
# Notice: app_user can only insert into AuditLogs, and has no update/delete permission on audit logs.
APP_DB_URI=

# Connection Pool & Timeout Configurations
MONGO_MIN_POOL_SIZE=5
MONGO_MAX_POOL_SIZE=50
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
